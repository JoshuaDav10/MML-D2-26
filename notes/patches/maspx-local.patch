+# Symbols whose bare-sym+reg accesses expand base-reg-first
+# (addu $at,reg,$at) in the original binary — main.c's D_801F81xx
+# family (func_80012F24/2E10/2FEC). Everything else expands $at-first.
+ASPSX_REGFIRST_SYM_PREFIXES = ("D_801F8",)
+
+
+def regfirst_quirk(operand):
+    return operand.startswith(ASPSX_REGFIRST_SYM_PREFIXES)
+
